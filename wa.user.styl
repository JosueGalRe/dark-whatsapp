/* ==UserStyle==
@name         Dark-WhatsApp
@description  Dark and light, very customizable theme for WhatsApp.
@namespace    github.com/JosueGalRe/dark-whatsapp
@homepageURL  https://github.com/JosueGalRe/dark-whatsapp
@supportURL   https://github.com/JosueGalRe/dark-whatsapp/issues
@updateURL    https://raw.githubusercontent.com/JosueGalRe/dark-whatsapp/master/wa.user.styl
@author       vednoc <vednoc@pm.me> (https://github.com/vednoc)
@version      4.1.0
@license      MIT
@preprocessor stylus

@var select   theme      'Base color-scheme toggle' {
    'Custom colors   *': 'custom',
    'Dark blue (old)  ': 'old',
    'Dark gray (new)  ': 'new',
    'Nord             ': 'nord',
    'Catppuccin Mocha ': 'mocha',
    'Catppuccin Latte ': 'latte',
    'Dracula          ': 'dracula',
    'Gruvbox Dark     ': 'gruvbox',
    'Tokyo Night      ': 'tokyo',
    'Rosé Pine        ': 'rose',
}

@var color    _bg        'Base background color        ' #1f232a
@var color    _fg        'Base foreground color        ' #eeeeee
@var color    _ac        'Base accent color            ' #7289da

@var range    _bg_a      'Adjust background color tones' [0, -25, 25, 0.1, '%']
@var range    _fg_a      'Adjust foreground color tones' [0, -25, 25, 0.1, '%']
@var range    _ac_a      'Adjust accent color tones    ' [0,   0, 25,   1, '%']
@var range    _sc_a      'Adjust syntax color tones    ' [0,   0, 25,   1, '%']

@var text     ui_font    'UI font' ''font_name''
@var text     app_width  'App width' 100%

@var checkbox compact    'Compact mode' 1
@var text     compact_mw 'Compact mode: only below this window width' 9999px
@var text     compact_hi 'Compact mode hover-on delay' 0.1s
@var text     compact_ho 'Compact mode hover-off delay' 0.25s

@var select   app_alerts 'Alerts' {
    'Show all                   *': 'show          ',
    'Hide "Allow notifications"  ': 'notifications ',
    'Hide all                    ': 'hide          ',
}

@var range    radius_a   'Rounded corners for avatars' [50, 0, 50, 1, '%']

@var select   tail_style 'Style for message bubble tails' {
    'Default  *': 'default ',
    'Minimal   ': 'minimal ',
    'Rounded   ': 'rounded ',
}

@var range    emoji_o    'Emoji opacity' [0.8, 0.0, 1, 0.01]

@var checkbox ow_ack     'Override seen message icon color' 0
@var color    _ack       'Seen message icon color' #ff6666

@var checkbox ow_sys_msg 'Override system message background color' 0
@var color    sys_msg_bg 'System message background color' #364462

@var checkbox ow_imsg    'Override incoming message bubble color' 0
@var color    _imsg  'Incoming message bubble color' #16191e

@var checkbox ow_omsg    'Override outgoing message bubble color' 0
@var color    _omsg  'Outgoing message bubble color' #3b4250

@var checkbox chat_h_p_p 'Hide profile pictures' 0
@var checkbox chat_b_c   'Blurred contacts' 0
@var range    chat_b_c_i 'Blurred contacts intensity' [6, 2, 15, 1, 'px']
@var checkbox chat_b_img 'Blurred media' 0
@var text     chat_b_in  'Blurred media hover-on delay' 0.4s
@var text     chat_b_out 'Blurred media hover-off delay' 0.2s

@var checkbox chat_bg    'Chat background image' 1
@var text     chat_image 'Custom chat background: url(data:...) or *.whatsapp.net, CSP blocks other hosts' none
@var range    chat_bg_o  'Chat background image opacity' [0.05, 0.0, 1, 0.01]
@var range    chat_bg_iv 'Custom chat background inverted colors' [0.6, 0.0, 1, 0.01]
@var text     chat_bg_s  'Custom chat background size' initial
@var text     chat_bg_p  'Custom chat background position' top left
@var text     chat_bg_r  'Custom chat background repeat' repeat

@var color    _red       'Base red color              ' #f07178
@var color    _orange    'Base orange color           ' #f78c6c
@var color    _yellow    'Base yellow color           ' #ffcb6b
@var color    _green     'Base green color            ' #c3e88d
@var color    _cyan      'Base cyan color             ' #89ddff
@var color    _blue      'Base blue color             ' #82aaff
@var color    _magenta   'Base magenta color          ' #c792ea
@var color    _violet    'Base violet color           ' #9a91ea
@var color    _white     'White color                 ' #ffffff
@var color    _sh        'Shadow color                ' #00000025
==/UserStyle== */

// Color mixin.
/// All colors: `c: fg1 bg5 bg1`
/// Only border-color: `c: 0 bg5`
c(x, y = 0, z = 0, xi = 1, yi = 1, zi = 1) {
    if x != 0 && x != '_' {            color: xi is 0 ? x : x i }
    if y != 0 && y != '_' {     border-color: yi is 0 ? y : y i }
    if z != 0 && z != '_' { background-color: zi is 0 ? z : z i }
}

// Raw RGB mixin.
/// Convert RGBA (if t = 1) or HEX to raw rrr-ggg-bbb format.
to_rgb(input, t = 0) {
    if (t) {
        unquote(substr(join(',', slice(split(',', s('%s', input)), 0, -1)), 5))
    } else {
        unquote(slice(s('%s', rgba(input, 0)), 5, -3))
    }
}

// Raw RGBA mixin.
/// Combine `*-rgb` vars and alpha value.
to_rgba(input, alpha) {
    unquote(s('rgba(var(--%s-rgb), %s)', unquote(input), alpha))
}

// WA design token mixins.
/// WDS tokens come in pairs: `--WDS-x` and `--WDS-x-RGB`.
wds(name, tone) {
    --WDS-{name}: s('var(--%s)', unquote(tone))
    --WDS-{name}-RGB: s('var(--%s-rgb)', unquote(tone))
}
wdsa(name, tone, alpha) {
    --WDS-{name}: to_rgba(tone, alpha)
    --WDS-{name}-RGB: s('var(--%s-rgb)', unquote(tone))
}

/// The tokens WA's chat themes set again on #main via a per-theme class.
chat_tokens() {
    wds('accent', 'ac-0')
    wds('accent-deemphasized', 'ac-4')
    wds('accent-emphasized', 'ac-em')
    wds('content-action-emphasized', 'ac-tx')
    wds('content-external-link', 'b5-0')
    wds('content-read', 'msg-ack')
    wds('systems-bubble-surface-incoming', 'msg-in-0')
    wds('systems-bubble-surface-outgoing', 'msg-out-0')
    wds('systems-bubble-content-deemphasized', 'fg-dim')
    wds('systems-chat-background-wallpaper', 'bg-1')
    wdsa('systems-bubble-surface-overlay', 'bg-0', 0.25)
    wdsa('systems-chat-foreground-wallpaper', 'fg-1', chat_bg_o)
}

// Rounded corners mixin.
rad() { border-radius: arguments }

/// Remove old browser prefixes.
vendors = official

/// Feat -> Base color-scheme toggle. #32
if (theme == 'custom') {
    BG       = _bg
    FG       = _fg
    AC       = _ac
} else if (theme == 'old') {
    BG       = #1f232a
    FG       = #eeeeee
    AC       = #7289da
    _red     = #f07178
    _orange  = #f78c6c
    _yellow  = #ffcb6b
    _green   = #c3e88d
    _cyan    = #89ddff
    _blue    = #82aaff
    _magenta = #c792ea
    _violet  = #9a91ea
} else if (theme == 'new') {
    BG       = #292929
    FG       = #e6e6e6
    AC       = #d47d3f
    _red     = #f2777a
    _orange  = #f99157
    _yellow  = #ffcc66
    _green   = #99cc99
    _cyan    = #66cccc
    _blue    = #6699cc
    _magenta = #cc99cc
    _violet  = #aa99cc
} else if (theme == 'nord') {
    BG       = #2e3440
    FG       = #eceff4
    AC       = #88c0d0
    _red     = #bf616a
    _orange  = #d08770
    _yellow  = #ebcb8b
    _green   = #a3be8c
    _cyan    = #8fbcbb
    _blue    = #81a1c1
    _magenta = #b48ead
    _violet  = #5e81ac
} else if (theme == 'mocha') {
    BG       = #1e1e2e
    FG       = #cdd6f4
    AC       = #cba6f7
    _red     = #f38ba8
    _orange  = #fab387
    _yellow  = #f9e2af
    _green   = #a6e3a1
    _cyan    = #89dceb
    _blue    = #89b4fa
    _magenta = #f5c2e7
    _violet  = #b4befe
} else if (theme == 'latte') {
    BG       = #eff1f5
    FG       = #4c4f69
    AC       = #8839ef
    _red     = #d20f39
    _orange  = #fe640b
    _yellow  = #df8e1d
    _green   = #40a02b
    _cyan    = #1e66f5
    _blue    = #1e66f5
    _magenta = #ea76cb
    _violet  = #7287fd
} else if (theme == 'dracula') {
    BG       = #282a36
    FG       = #f8f8f2
    AC       = #bd93f9
    _red     = #ff5555
    _orange  = #ffb86c
    _yellow  = #f1fa8c
    _green   = #50fa7b
    _cyan    = #8be9fd
    _blue    = #bd93f9
    _magenta = #ff79c6
    _violet  = #bd93f9
} else if (theme == 'gruvbox') {
    BG       = #282828
    FG       = #ebdbb2
    AC       = #fe8019
    _red     = #fb4934
    _orange  = #fe8019
    _yellow  = #fabd2f
    _green   = #b8bb26
    _cyan    = #8ec07c
    _blue    = #83a598
    _magenta = #d3869b
    _violet  = #d3869b
} else if (theme == 'tokyo') {
    BG       = #1a1b26
    FG       = #c0caf5
    AC       = #7aa2f7
    _red     = #f7768e
    _orange  = #ff9e64
    _yellow  = #e0af68
    _green   = #9ece6a
    _cyan    = #7dcfff
    _blue    = #7aa2f7
    _magenta = #bb9af7
    _violet  = #9d7cd8
} else if (theme == 'rose') {
    BG       = #191724
    FG       = #e0def4
    AC       = #c4a7e7
    _red     = #eb6f92
    _orange  = #ebbcba
    _yellow  = #f6c177
    _green   = #9ccfd8
    _cyan    = #9ccfd8
    _blue    = #31748f
    _magenta = #c4a7e7
    _violet  = #c4a7e7
}

/// Helpers.
t  = transparent
i  = !important
BA = _bg_a
FA = _fg_a
AA = _ac_a
SA = _sc_a
IM = _imsg
OM = _omsg

// Tone base: dark palettes mix towards black, light ones towards the page.
mix_base(amount) {
    dark(BG) ? darken(BG, amount) : BG
}

// Color generator.
/// NOTE: Scope the variables to avoid potential conflicts.
/{
    g = global

    /// Color generator rules.
    if (dark(BG)) {
        a1 = (AA + 15); a2 = (AA + 30); a3 = (AA + 45); a4 = (AA + 65); a5 = (AA + 75)
        s1 = (SA + 15); s2 = (SA + 30); s3 = (SA + 45); s4 = (SA + 65); s5 = (SA + 75)
        b1 = (BA + 10); b2 = (BA - 05); b3 = (BA - 10); b4 = (BA - 15); b5 = (BA - 20)
        f1 = (FA - 10); f2 = (FA + 10); f3 = (FA + 20); f4 = (FA + 30); f5 = (FA + 40)
    } else {
        /// On a light page these are how much page is left, so text stays on a light tint.
        a1 = (AA + 15); a2 = (AA + 30); a3 = (AA + 45); a4 = (AA + 85); a5 = (AA + 92)
        s1 = (SA + 15); s2 = (SA + 30); s3 = (SA + 45); s4 = (SA + 65); s5 = (SA + 75)
        b1 = (BA - 10); b2 = (BA + 08); b3 = (BA + 16); b4 = (BA + 24); b5 = (BA + 32)
        f1 = (FA - 05); f2 = (FA - 10); f3 = (FA - 15); f4 = (FA - 20); f5 = (FA - 30)
    }

    /// Feat -> Colors for message bubbles.
    ig_quote = dark(IM) ? -10% : 25%
    og_quote = dark(OM) ? -10% : 25%

    /// Generate tones for base colors.
    C = {
        bg: {
            '0': darken(BG, b1),
            '1': darken(BG, 0%),
            '2': darken(BG, b2),
            '3': darken(BG, b3),
            '4': darken(BG, b4),
            '5': darken(BG, b5),
        },
        fg: {
            '0': darken(FG, f1),
            '1': darken(FG, 0%),
            '2': darken(FG, f2),
            '3': darken(FG, f3),
            '4': darken(FG, f4),
            '5': darken(FG, f5),
        },
        ac: {
            '0': mix(darken(BG,  0%), AC, 0%),
            '1': mix(mix_base(40%), AC, a1),
            '2': mix(mix_base(40%), AC, a2),
            '3': mix(mix_base(40%), AC, a3),
            '4': mix(mix_base(65%), AC, a4),
            '5': mix(mix_base(50%), AC, a5),
        },
        ig: {
            '0':        IM,
            '1': darken(IM, ig_quote),
        },
        og: {
            '0':        OM,
            '1': darken(OM, og_quote),
        },
        b1: {
            '0': spin(_red,  0deg - 0%)
            '1': spin(_red, 15deg - s1)
            '2': spin(_red, 30deg - s2)
            '3': mix(mix_base(20%), _red, s3)
            '4': mix(mix_base(40%), _red, s4)
            '5': mix(mix_base(40%), _red, s5)
        },
        b2: {
            '0': spin(_orange,  0deg - 0%)
            '1': spin(_orange, 15deg - s1)
            '2': spin(_orange, 30deg - s2)
            '3': mix(mix_base(20%), _orange, s3)
            '4': mix(mix_base(40%), _orange, s4)
            '5': mix(mix_base(40%), _orange, s5)
        },
        b3: {
            '0': spin(_yellow,  0deg - 0%)
            '1': spin(_yellow, 15deg - s1)
            '2': spin(_yellow, 30deg - s2)
            '3': mix(mix_base(20%), _yellow, s3)
            '4': mix(mix_base(40%), _yellow, s4)
            '5': mix(mix_base(40%), _yellow, s5)
        },
        b4: {
            '0': spin(_green,  0deg - 0%)
            '1': spin(_green, 15deg - s1)
            '2': spin(_green, 30deg - s2)
            '3': mix(mix_base(20%), _green, s3)
            '4': mix(mix_base(40%), _green, s4)
            '5': mix(mix_base(40%), _green, s5)
        },
        b5: {
            '0': spin(_cyan,  0deg - 0%)
            '1': spin(_cyan, 15deg - s1)
            '2': spin(_cyan, 30deg - s2)
            '3': mix(mix_base(20%), _cyan, s3)
            '4': mix(mix_base(40%), _cyan, s4)
            '5': mix(mix_base(40%), _cyan, s5)
        },
        b6: {
            '0': spin(_blue,  0deg - 0%)
            '1': spin(_blue, 15deg - s1)
            '2': spin(_blue, 30deg - s2)
            '3': mix(mix_base(20%), _blue, s3)
            '4': mix(mix_base(40%), _blue, s4)
            '5': mix(mix_base(40%), _blue, s5)
        },
        b7: {
            '0': spin(_magenta,  0deg - 0%)
            '1': spin(_magenta, 15deg - s1)
            '2': spin(_magenta, 30deg - s2)
            '3': mix(mix_base(20%), _magenta, s3)
            '4': mix(mix_base(40%), _magenta, s4)
            '5': mix(mix_base(40%), _magenta, s5)
        },
        b8: {
            '0': spin(_violet,  0deg - 0%)
            '1': spin(_violet, 15deg - s1)
            '2': spin(_violet, 30deg - s2)
            '3': mix(mix_base(20%), _violet, s3)
            '4': mix(mix_base(40%), _violet, s4)
            '5': mix(mix_base(40%), _violet, s5)
        }
    }

    /// Generate Stylus-lang variables.
    define('bg-' + key, val, g) for key, val in C.bg
    define('fg-' + key, val, g) for key, val in C.fg
    define('ac-' + key, val, g) for key, val in C.ac
    define('og-' + key, val, g) for key, val in C.og
    define('ig-' + key, val, g) for key, val in C.ig
    define('b1-' + key, val, g) for key, val in C.b1
    define('b2-' + key, val, g) for key, val in C.b2
    define('b3-' + key, val, g) for key, val in C.b3
    define('b4-' + key, val, g) for key, val in C.b4
    define('b5-' + key, val, g) for key, val in C.b5
    define('b6-' + key, val, g) for key, val in C.b6
    define('b7-' + key, val, g) for key, val in C.b7
    define('b8-' + key, val, g) for key, val in C.b8

    /// Generate Stylus-lang helpers for CSS variables.
    define('bg' + key, s('var(--bg-%s)', unquote(key)), g) for key, val in C.bg
    define('fg' + key, s('var(--fg-%s)', unquote(key)), g) for key, val in C.fg
    define('ac' + key, s('var(--ac-%s)', unquote(key)), g) for key, val in C.ac
    define('b1' + key, s('var(--b1-%s)', unquote(key)), g) for key, val in C.b1
    define('b2' + key, s('var(--b2-%s)', unquote(key)), g) for key, val in C.b2
    define('b3' + key, s('var(--b3-%s)', unquote(key)), g) for key, val in C.b3
    define('b4' + key, s('var(--b4-%s)', unquote(key)), g) for key, val in C.b4
    define('b5' + key, s('var(--b5-%s)', unquote(key)), g) for key, val in C.b5
    define('b6' + key, s('var(--b6-%s)', unquote(key)), g) for key, val in C.b6
    define('b7' + key, s('var(--b7-%s)', unquote(key)), g) for key, val in C.b7
    define('b8' + key, s('var(--b8-%s)', unquote(key)), g) for key, val in C.b8
}

@-moz-document domain('web.whatsapp.com') {
    :root:not(#z), .dark:not(#z) {
        /// UI font.
        --ui-font: ui_font, Segoe UI, Helvetica Neue, Helvetica, Lucida Grande,
                   Arial, Ubuntu, Cantarell, Fira Sans, sans-serif

        /// Rounded corners.
        --r-avatars: radius_a

        /// Compact mode.
        --c-m-hover: compact_hi
        --c-m-delay: compact_ho
        --c-m-open: unquote('inset(0 -290px 0 0)')
        --c-m-row: unquote('inset(0 calc(100% - 74px) 0 0 round 12px)')
        --c-m-search: unquote('inset(2px calc(100% - 46px) 2px 6px round 20px)')
        --c-m-new: -263px
        --c-m-menu: 48px

        /// Blurred contacts.
        --blur-contacts: chat_b_c_i

        /// Blurred media.
        --blur-in:  chat_b_in
        --blur-out: chat_b_out

        /// App width.
        --app-width: app_width

        /// Emoji opacity.
        --emoji-o: emoji_o

        /// Chat background.
        --chat-image: chat_image
        --chat-bg-o:  chat_bg_o
        --chat-bg-i:  chat_bg_iv
        --chat-bg-s:  chat_bg_s
        --chat-bg-p:  chat_bg_p
        --chat-bg-r:  chat_bg_r

        /// Startup splash. WA sets these inline on <html>, so only !important beats them.
        --splashscreen-startup-background-plain: bg-0 i
        --splashscreen-startup-background: bg-0 i
        --splashscreen-startup-background-rgb: to_rgb(bg-0) i
        --splashscreen-startup-content-deemphasized: fg-3 i
        --splashscreen-startup-icon: fg-5 i
        --splashscreen-primary-title: fg-1 i
        --splashscreen-secondary-lighter: fg-3 i
        --splashscreen-progress-primary: ac-0 i
        --splashscreen-progress-background: bg-3 i

        /// Override incoming message bubble colors.
        in_tone = dark(BG) ? 'bg-4' : 'bg-2'
        --msg-in-0:     (ow_imsg) ? ig-0         : s('var(--%s)', unquote(in_tone))
        --msg-in-0-rgb: (ow_imsg) ? to_rgb(ig-0) : s('var(--%s-rgb)', unquote(in_tone))

        /// Override outgoing message bubble colors.
        --msg-out-0:     (ow_omsg) ? og-0         : var(--ac-4)
        --msg-out-0-rgb: (ow_omsg) ? to_rgb(og-0) : var(--ac-4-rgb)

        /// Override system message background color.
        --msg-sys:     (ow_sys_msg) ? sys_msg_bg         : var(--bg-2)
        --msg-sys-rgb: (ow_sys_msg) ? to_rgb(sys_msg_bg) : var(--bg-2-rgb)

        /// Secondary text. Mixed towards the page because darkening a tinted foreground
        /// saturates it, and it has to hold up on bubbles too.
        fg_dim = mix(FG, BG, dark(BG) ? 82% : 95%)
        --fg-dim:     fg_dim
        --fg-dim-rgb: to_rgb(fg_dim)

        /// Accent as text on regular surfaces.
        --ac-tx:     mix(AC, FG, 70%)
        --ac-tx-rgb: to_rgb(mix(AC, FG, 70%))

        /// Text on accent-deemphasized: accent pulled towards the foreground.
        --ac-em:     mix(AC, FG, 30%)
        --ac-em-rgb: to_rgb(mix(AC, FG, 30%))

        /// Text on accent: pick whichever side of 0.179 luminance contrasts more.
        on_ac = (luminosity(AC) > 0.179) ? (dark(BG) ? bg-0 : #000) : _white
        --on-ac:     on_ac
        --on-ac-rgb: to_rgb(on_ac)

        /// Override seen message icon color.
        --msg-ack:     (ow_ack) ? _ack         : var(--b5-0)
        --msg-ack-rgb: (ow_ack) ? to_rgb(_ack) : var(--b5-0-rgb)

        /// WA design tokens. Every current surface resolves through these; the
        /// `.x…` theme classes on <html> set them, `:not(#z)` outranks those.
        wds('background-wash-plain', 'bg-0')
        wds('background-wash-inset', 'bg-0')
        wds('background-elevated-wash-plain', 'bg-2')
        wds('background-elevated-wash-inset', 'bg-2')
        wds('surface-default', 'bg-1')
        wds('surface-emphasized', 'bg-2')
        wds('surface-elevated-default', 'bg-2')
        wds('surface-elevated-emphasized', 'bg-3')
        wds('surface-inverse', 'fg-1')
        wds('content-default', 'fg-1')
        wds('content-deemphasized', 'fg-dim')
        wds('content-disabled', 'fg-5')
        wds('content-inverse', 'bg-1')
        wds('content-on-accent', 'on-ac')
        wds('content-action-default', 'fg-1')
        wds('lines-divider', 'bg-4')
        wds('lines-outline-deemphasized', 'bg-5')
        wds('lines-outline-default', 'fg-5')
        wds('persistent-activity-indicator', 'ac-0')
        wds('persistent-always-branded', 'ac-0')
        wds('persistent-verified', 'b6-0')
        wds('secondary-negative', 'b1-0')
        wds('secondary-negative-deemphasized', 'b1-5')
        wds('secondary-negative-emphasized', 'b1-1')
        wds('secondary-positive', 'b4-0')
        wds('secondary-positive-deemphasized', 'b4-5')
        wds('secondary-warning', 'b3-0')
        wds('secondary-warning-deemphasized', 'b3-5')
        wds('components-filter-surface-selected', 'ac-4')
        wds('components-surface-nav-bar', 'bg-0')
        wds('systems-bubble-surface-system', 'msg-sys')
        wds('systems-bubble-surface-business', 'bg-2')
        wds('systems-bubble-surface-e2e', 'bg-2')
        wds('systems-bubble-content-business', 'b5-0')
        wds('systems-bubble-content-e2e', 'b3-0')
        wds('systems-chat-surface-composer', dark(BG) ? 'bg-3' : 'bg-2')
        wds('systems-chat-surface-tray', 'bg-1')
        wds('systems-status-seen', 'fg-5')

        /// Tokens WA also re-declares further down, see `#main:not(#z)`.
        chat_tokens()

        /// Translucent tokens: state washes that have to sit on any surface.
        wdsa('surface-highlight', 'fg-1', 0.08)
        wdsa('surface-pressed', 'fg-1', 0.14)
        wdsa('components-active-list-row', 'ac-0', 0.18)
        wdsa('components-badge-muted', 'fg-1', 0.1)
        wdsa('components-badge-muted-dot', 'fg-1', 0.1)
        wdsa('components-outline-profile-photo', 'fg-1', 0.08)
        wdsa('background-dimmer', 'bg-0', 0.6)

        /// Placeholder avatars: palette tone on its own dark mix.
        wds('components-profile-photo-surface-brown', 'b2-4')
        wds('components-profile-photo-content-brown', 'b2-0')
        wds('components-profile-photo-surface-cobalt', 'b6-4')
        wds('components-profile-photo-content-cobalt', 'b6-0')
        wds('components-profile-photo-surface-gray', 'bg-4')
        wds('components-profile-photo-content-gray', 'fg-3')
        wds('components-profile-photo-surface-green', 'b4-4')
        wds('components-profile-photo-content-green', 'b4-0')
        wds('components-profile-photo-surface-orange', 'b2-4')
        wds('components-profile-photo-content-orange', 'b2-0')
        wds('components-profile-photo-surface-pink', 'b7-4')
        wds('components-profile-photo-content-pink', 'b7-0')
        wds('components-profile-photo-surface-purple', 'b8-4')
        wds('components-profile-photo-content-purple', 'b8-0')
        wds('components-profile-photo-surface-red', 'b1-4')
        wds('components-profile-photo-content-red', 'b1-0')
        wds('components-profile-photo-surface-sky-blue', 'b5-4')
        wds('components-profile-photo-content-sky-blue', 'b5-0')
        wds('components-profile-photo-surface-teal', 'b5-4')
        wds('components-profile-photo-content-teal', 'b5-0')
        wds('components-profile-photo-surface-yellow', 'b3-4')
        wds('components-profile-photo-content-yellow', 'b3-0')

        /// Legacy WA variables still referenced by current CSS.
        --gray-30: var(--bg-5)
        --gray-700: var(--fg-4)
        --teal-rgb: var(--ac-0-rgb)
        --green-deep: var(--ac-2)
        --green-deep-rgb: var(--ac-2-rgb)
        --app-background-stripe: var(--bg-1)
        --app-background-deeper: var(--bg-0)
        --attach-media-drop-border: var(--fg-3)
        --attach-media-drop-overlay: var(--bg-2)
        --audio-progress-incoming: var(--b4-0)
        --audio-progress-outgoing: var(--ac-2)
        --audio-progress-played-incoming: var(--b6-0)
        --audio-progress-played-outgoing: var(--b6-0)
        --audio-track-incoming: var(--fg-4)
        --audio-track-outgoing: var(--fg-4)
        --avatar-background: var(--bg-1)
        --avatar-border: var(--bg-3)
        --background-default-rgb: var(--bg-2-rgb)
        --background-default-hover-rgb: var(--bg-3-rgb)
        --button-bubble: var(--ac-0)
        --chevron-button-background: var(--bg-3)
        --compose-panel-background-hover: var(--bg-4)
        --danger-rgb: var(--b1-0-rgb)
        --dropdown-background: var(--bg-2)
        --empty-state-background: var(--bg-3)
        --empty-state-icon: var(--fg-4)
        --icon-disabled: var(--fg-5)
        --icon-strong-rgb: var(--fg-1-rgb)
        --intro-secondary: var(--fg-3)
        --inverse-rgb: var(--fg-0-rgb)
        --labels-icon: #f1f1f266
        --link-rgb: var(--ac-0-rgb)
        --media-editor-control-rgb: 28,49,63
        --message-placeholder-icon: var(--fg-3)
        --message-primary-rgb: var(--fg-1-rgb)
        --message-selection-highlight: to_rgba('ac-0', 0.1)
        --modal-backdrop-solid: var(--bg-0)
        --notification-biz-background: var(--b5-5)
        --notification-biz-text: var(--b5-0)
        --overlay: var(--bg-0)
        --overlay-rgb: var(--bg-0-rgb)
        --panel-background: var(--bg-3)
        --panel-background-rgb: var(--bg-3-rgb)
        --panel-background-deep: var(--bg-2)
        --panel-input-background: var(--bg-2)
        --payment-status-failed: #ef697a
        --payment-status-success: #40cf6c
        --picker-background: var(--bg-2)
        --primary-rgb: var(--fg-2-rgb)
        --primary-strong-rgb: var(--fg-1-rgb)
        --primary-stronger-rgb: var(--fg-0-rgb)
        --product-image-button-background: var(--bg-4)
        --product-thumb-background: var(--bg-3)
        --product-thumb-background-deeper: var(--bg-2)
        --progress-background: var(--bg-2)
        --ptt-blue: var(--b6-0)
        --ptt-gray: var(--fg-4)
        --ptt-green: var(--b4-0)
        --search-input-background: var(--bg-3)
        --secondary-rgb: var(--fg-3-rgb)
        --shadow-rgb: var(--sh-rgb)
        --spinner-incoming: var(--fg-5)
        --spinner-outgoing: var(--ac-5)
        --startup-icon: var(--fg-3)
        --status-background-rgb: var(--bg-1-rgb)
        --status-primary-rgb: var(--fg-1-rgb)
        --status-secondary: var(--fg-4)
        --suspicious-background: #ef697acc
        --text-muted: var(--fg-4)
        --thumb-border-viewer-active-rgb: var(--fg-3-rgb)
        --toast-background: to_rgba('bg-3', 0.96)
        --tooltip-background: to_rgba('bg-4', 0.85)
        --video-player-background: #000
        --video-primary: #fff
        --video-primary-rgb: 255,255,255
        --voip-primary-rgb: 255,255,255
        --reactions-tray-active-round-background: var(--bg-5)
        --text-primary-strong: var(--fg-1)

        /// Generate DWA color variables.
        for _v in (bg fg ac b1 b2 b3 b4 b5 b6 b7 b8) {
            for _i in 0..5 {
                key = s('--%s-%s', _v, _i)
                /// Escape `\` for `*-0` vars.
                val = _v + \- + _i

                /// Generate CSS variables.
                { key }: val
                { key + '-rgb' }: to_rgb(val)
            }
        }

        /// Misc colors.
        --white:      _white
        --white-rgb:  to_rgb(_white)
        --sh:         _sh
        --sh-rgb:     to_rgb(_sh, 1)
        --t:          transparent
        --bshadow:    0 4px 8px 2px var(--shadow)

    }

    // Chat themes outrank :root in their subtree, so the theme has to be set there too.
    /// `.xoeyzqq` marks every such scope, popovers included. It's a build hash: if it
    /// changes, popovers go back to WA's accent, #main still holds.
    #main:not(#z), .xoeyzqq:not(#z) {
        chat_tokens()
    }

    // Global styles.
    html > body {
        c: fg0 0 bg0

        /// Feat -> Custom font. Leave WA's own typeface alone unless one is set.
        if (ui_font != 'font_name') {
            &, button, input { font-family: var(--ui-font) }
        }
    }

    // Scrollbars.
    * { scrollbar-color: ac2 t i }

    // Modals. Elevated surfaces are close in tone to the dimmed app behind them.
    [data-animate-modal-popup] { border: 1px solid bg5 }

    // Feat -> Rounded corners for avatars, hide profile pictures.
    /// Group avatars can also be an SVG <image>, which border-radius can't reach.
    #side img:not(.emoji),
    #main header img,
    [data-testid='group-chat-profile-picture'] img,
    img[src*='pps.whatsapp.net'] {
        rad: var(--r-avatars) i
        if (chat_h_p_p) { visibility: hidden i }
    }
    if (chat_h_p_p) {
        image[*|href*='pps.whatsapp.net'] { visibility: hidden i }
    }

    // Feat -> Emoji opacity.
    img.emoji:not(:hover) { opacity: var(--emoji-o) }

    // Feat -> Alerts.
    if (app_alerts == 'hide') {
        [data-testid='chat-butterbar'] { display: none i }
    } else if (app_alerts == 'notifications') {
        /// The icon has no data-icon anymore. Matching its path fails safe: if WA
        /// redraws it, the banner just comes back.
        [data-testid='chat-butterbar']:has(path[d^='M16.15 19H5']) { display: none i }
    }

    // Feat -> Blur contacts.
    if (chat_b_c) {
        #pane-side [data-testid='cell-frame-container'] > * { transition: filter 0.2s ease }
        #pane-side [role='row']:not(:hover):not(:has([aria-selected='true'])) [data-testid='cell-frame-container'] > * {
            filter: blur(var(--blur-contacts))
        }
    }

    // Chat.
    /// Feat -> Chat background. The doodle is a mask over the foreground token.
    [data-testid^='conversation-background-'] {
        opacity: 1 i
        if (!chat_bg) { display: none i }
        if (chat_image != none) {
            mask-image: none i
            filter: invert(var(--chat-bg-i)) opacity(var(--chat-bg-o))
            background-color: t i
            background-image: var(--chat-image) i
            background-position: var(--chat-bg-p) i
            background-repeat: var(--chat-bg-r) i
            background-size: var(--chat-bg-s) i
        }
    }

    /// Location previews are static map images.
    #main img[src*='maps.googleapis.com'] { filter: invert(0.8) hue-rotate(180deg) }

    /// Feat -> Message tails.
    if (tail_style != 'default') {
        [data-icon^='tail-'] {
            display: none i
            if (tail_style == 'rounded') {
                + div { rad: 7.5px i }
            }
        }
    }

    /// Feat -> Blur media. Reveal on bubble hover: overlays can sit on top of the image.
    if (chat_b_img) {
        #main [data-testid='msg-container'] img:not(.emoji):not([src*='pps.whatsapp.net']),
        #main [data-testid='msg-container'] video {
            transition: filter 0.5s ease var(--blur-out)
            filter: blur(16px) grayscale(100%)
        }
        #main [data-testid='msg-container']:hover img:not(.emoji):not([src*='pps.whatsapp.net']),
        #main [data-testid='msg-container']:hover video {
            transition-delay: var(--blur-in)
            filter: none
        }
    }

    // Layout.
    /// Feat -> App width. WA is always full-bleed now; this is what bounds it.
    .two, .three {
        max-width: var(--app-width)
        margin-inline: auto i
    }

    /// Feat -> Compact mode. The list stays an avatar rail in the layout and floats
    /// over the chat when open: only clip-path and opacity animate, so neither the
    /// messages nor the row under the cursor ever move.
    if (compact) {
        @media screen and (max-width: compact_mw) {
            /// WA's own 748px floor is what clips #main on small windows.
            .two, .three { min-width: 0 i }

            /// This empty layer's divider marks the native split, not ours.
            [data-testid='drawer-middle'] { border-inline-start: none i }

            /// A permanent nag, and showing it only when open would shift every row.
            [data-testid='chat-butterbar']:has(path[d^='M16.15 19H5']) { display: none i }

            html[dir='rtl']:not(#z) {
                --c-m-open: unquote('inset(0 0 0 -290px)')
                --c-m-row: unquote('inset(0 0 0 calc(100% - 74px) round 12px)')
                --c-m-search: unquote('inset(2px 6px 2px calc(100% - 46px) round 20px)')
                --c-m-new: 263px
                --c-m-menu: -48px
            }

            .two > :has(> #side), .three > :has(> #side) {
                flex: 0 0 96px i
                min-width: 0 i
                max-width: 96px i
                overflow: visible i
                clip-path: inset(0)
                transition: clip-path 0.2s ease var(--c-m-delay)

                > * {
                    width: 350px i
                    max-width: none i
                    c: 0 0 bg1
                }

                /// The chat starts here now, not at WA's native split.
                + div { border-inline-start: 1px solid bg4 }

                /// Edge of the open list, past the rail so collapsing clips it away.
                /// Behind the list, or its z-indexed parts cut it and the shadow into strips.
                &::after {
                    content: ''
                    position: absolute
                    z-index: -1
                    top: -40px
                    bottom: -40px
                    inset-inline-start: 351px
                    width: 1px
                    pointer-events: none
                    background-color: bg4
                    box-shadow: 0 0 24px 6px rgba(0, 0, 0, 0.4)
                }

                /// Fades instead of leaving the layout: they stay focusable, and
                /// focus is what opens the list from the keyboard.
                [data-testid='drawer-title-body'],
                [data-testid='chat-list-search-container'] input,
                [role='tablist'],
                [data-testid='chatlist-e2e-message'] {
                    opacity: 0
                    transition: opacity 0.2s ease var(--c-m-delay)
                }

                /// The search pill shrinks to a circle around its icon, on the rail's axis.
                [data-testid='chat-list-search-container'] > div {
                    clip-path: var(--c-m-search)
                    transition: clip-path 0.2s ease var(--c-m-delay)
                }

                /// New chat lives on the rail's axis, open or closed, so it's never a
                /// moving target. The labels are on the inner buttons, but the hit area and
                /// tooltip belong to the wrappers: move the outermost one that holds just
                /// that button. The labels are localized: on a miss the header stays native.
                :has([aria-label='Menu']) > :has([aria-label='New chat']):not(:has([aria-label='Menu'])) {
                    transform: translateX(var(--c-m-new))
                }
                :has([aria-label='New chat']) > :has([aria-label='Menu']):not(:has([aria-label='New chat'])) {
                    transform: translateX(var(--c-m-menu))
                }
                header:has([aria-label='New chat']) [data-testid='drawer-title-body'] {
                    margin-inline-start: 60px
                }

                /// Row highlight as a pill around the avatar.
                [data-testid='cell-frame-container'] {
                    position: relative
                    clip-path: var(--c-m-row)
                    transition: clip-path 0.2s ease var(--c-m-delay)
                }

                /// Same spot open or closed, so the badges never jump.
                [role='row'] [data-testid='icon-unread-count'],
                [data-testid='chatlist-panel-archived-button'] [data-testid='icon-unread-count'] {
                    position: absolute i
                    top: 8px
                    inset-inline-start: 46px
                    z-index: 1
                }

                /// Natively bare text at the far end of the row.
                [data-testid='chatlist-panel-archived-button'] [data-testid='icon-unread-count'] {
                    display: flex
                    align-items: center
                    justify-content: center
                    min-width: 18px
                    height: 18px
                    padding: 0 4px
                    font-size: 11px
                    rad: 9px
                    c: fg3 0 var(--WDS-components-badge-muted)
                }

                &:hover, &:focus-within {
                    clip-path: var(--c-m-open)
                    transition-delay: var(--c-m-hover)

                    [data-testid='drawer-title-body'],
                    [data-testid='chat-list-search-container'] input,
                    [role='tablist'],
                    [data-testid='chatlist-e2e-message'] {
                        opacity: 1
                        transition-delay: var(--c-m-hover)
                    }

                    /// Past the pill's edge, so the focus ring isn't clipped.
                    [data-testid='chat-list-search-container'] > div {
                        clip-path: inset(-4px round 24px)
                        transition-delay: var(--c-m-hover)
                    }

                    [data-testid='cell-frame-container'] {
                        clip-path: inset(0 0 0 0 round 12px)
                        transition-delay: var(--c-m-hover)
                    }
                }

            }

            @media (prefers-reduced-motion: reduce) {
                .two > :has(> #side),
                .two > :has(> #side) *,
                .three > :has(> #side),
                .three > :has(> #side) * { transition: none i }
            }
        }
    }
}
